<div class="rail-profondeur" data-controller="depth-rail">
    <div class="rail-profondeur__graduations">
        <div class="rail-profondeur__trait"></div>
        <div class="rail-profondeur__graduation"><span class="rail-profondeur__marque rail-profondeur__marque--longue"></span><span>0 m</span></div>
        <div class="rail-profondeur__graduation"><span class="rail-profondeur__marque"></span><span>50</span></div>
        <div class="rail-profondeur__graduation"><span class="rail-profondeur__marque rail-profondeur__marque--longue"></span><span>100 m</span></div>
        <div class="rail-profondeur__graduation"><span class="rail-profondeur__marque"></span><span>200</span></div>
        <div class="rail-profondeur__graduation"><span class="rail-profondeur__marque rail-profondeur__marque--longue"></span><span>300 m</span></div>
        <div class="rail-profondeur__curseur" data-depth-rail-target="curseur">
            <div class="rail-profondeur__ligne"></div>
            <div class="rail-profondeur__libelle" data-depth-rail-target="libelle"></div>
        </div>
    </div>
</div>
