{% set route = app.request.attributes.get('_route') %}
{% set route_params = app.request.attributes.get('_route_params') %}
<div class="selecteur-langue">
    {% for loc in ['fr', 'en'] %}
        <a href="{{ path(route, route_params|merge({_locale: loc})) }}"
           class="selecteur-langue__option{% if app.request.locale == loc %} selecteur-langue__option--active{% endif %}">{{ loc|upper }}</a>
    {% endfor %}
</div>
