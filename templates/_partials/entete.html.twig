{% set locale = app.request.locale %}
<header class="entete">
    <a href="{{ path('accueil', {_locale: locale}) }}" class="entete__logo">
        <img src="{{ asset('logo-ti-baleine.jpg') }}" alt="{{ 'site.nom'|trans }}">
        <span>{{ 'site.nom'|trans }}</span>
    </a>
    <nav class="entete__nav">
        <a href="{{ path('sorties', {_locale: locale}) }}">{{ 'site.nav.sorties'|trans }}</a>
        <a href="{{ path('flotte', {_locale: locale}) }}">{{ 'site.nav.bateau'|trans }}</a>
        <a href="{{ path('tarifs', {_locale: locale}) }}">{{ 'site.nav.tarifs'|trans }}</a>
        <a href="{{ path('bon_cadeau', {_locale: locale}) }}">{{ 'site.nav.bon_cadeau'|trans }}</a>
        {% include '_partials/selecteur_langue.html.twig' %}
        <a href="{{ path('calendrier', {_locale: locale}) }}" class="bouton bouton-principal entete__reserver">{{ 'site.nav.reserver'|trans }}</a>
    </nav>
</header>
