<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Domaine\Entite\Notification" table="notification">
        <indexes>
            <index name="idx_notification_reservation_type" columns="reservation_id,type"/>
        </indexes>

        <id name="id" type="integer" column="id">
            <generator strategy="IDENTITY"/>
        </id>

        <field name="type" type="string" column="type" length="30" nullable="false"/>
        <field name="canal" type="string" column="canal" length="10" nullable="false"/>
        <field name="dateDenvoi" type="datetime_immutable" column="date_envoi" nullable="false"/>
        <field name="statut" type="string" column="statut" length="10" nullable="false"/>

        <many-to-one field="reservation" target-entity="App\Domaine\Entite\Reservation">
            <join-column name="reservation_id" referenced-column-name="id" nullable="false"/>
        </many-to-one>
    </entity>
</doctrine-mapping>
