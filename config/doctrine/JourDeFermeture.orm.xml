<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Domaine\Entite\JourDeFermeture" table="jour_fermeture">
        <unique-constraints>
            <unique-constraint name="uniq_jour_fermeture_date" columns="date_fermeture"/>
        </unique-constraints>

        <id name="id" type="integer" column="id">
            <generator strategy="IDENTITY"/>
        </id>

        <field name="date" type="date_immutable" column="date_fermeture" nullable="false"/>
        <field name="recurrentAnnuel" type="boolean" column="recurrent_annuel" nullable="false"/>
    </entity>
</doctrine-mapping>
